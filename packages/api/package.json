{
  "name": "@ever-brain/api",
  "version": "1.0.0",
  "description": "Ever-Brain API — Stateless Content Access Layer",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/types/contract.d.ts",
      "import": "./dist/types/contract.js",
      "default": "./dist/types/contract.js"
    },
    "./utils/binary-filter": {
      "types": "./dist/utils/binary-filter.d.ts",
      "import": "./dist/utils/binary-filter.js",
      "default": "./dist/utils/binary-filter.js"
    },
    "./utils/binary-filter.js": {
      "types": "./dist/utils/binary-filter.d.ts",
      "import": "./dist/utils/binary-filter.js",
      "default": "./dist/utils/binary-filter.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "dotenv": "^16.4.7",
    "hono": "^4.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

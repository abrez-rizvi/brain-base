{
  "name": "ever-brain",
  "version": "1.0.0",
  "private": true,
  "description": "Ever-Brain — The Shared Project Intelligence Layer",
  "scripts": {
    "dev": "pnpm --parallel --filter @ever-brain/api --filter @ever-brain/mcp dev",
    "dev:api": "pnpm --filter @ever-brain/api dev",
    "dev:mcp": "pnpm --filter @ever-brain/mcp dev",
    "dev:cli": "pnpm --filter @ever-brain/cli dev",
    "evb": "node packages/cli/dist/index.js",
    "cli": "node packages/cli/dist/index.js",
    "cli:link": "pnpm link --global ./packages/cli",
    "cli:unlink": "pnpm unlink --global @ever-brain/cli",
    "start": "node scripts/start-server.mjs",
    "prepare": "pnpm build",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "clean": "pnpm --recursive run clean",
    "setup": "pnpm install && pnpm build"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@ever-brain/cli": "link:packages/cli"
  }
}

{
  "name": "knowiki",
  "version": "1.0.0",
  "private": true,
  "description": "Knowiki — The Shared Project Intelligence Layer",
  "scripts": {
    "dev": "pnpm --parallel --filter @knowiki/api --filter @knowiki/mcp dev",
    "dev:api": "pnpm --filter @knowiki/api dev",
    "dev:mcp": "pnpm --filter @knowiki/mcp dev",
    "dev:cli": "pnpm --filter @knowiki/cli dev",
    "knowiki": "node packages/cli/dist/index.js",
    "cli": "node packages/cli/dist/index.js",
    "cli:link": "pnpm --dir packages/cli link --global",
    "cli:unlink": "pnpm --dir packages/cli unlink --global",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "clean": "pnpm --recursive run clean",
    "setup": "pnpm install && pnpm build"
  },
  "overrides": {
    "jose": "6.2.9"
  },
  "onlyBuiltDependencies": [
    "esbuild"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}

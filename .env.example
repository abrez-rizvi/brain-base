# ==============================================================================
# Knowiki Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for local development:
#   cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (Windows)

# ------------------------------------------------------------------------------
# API Service Configuration (@knowiki/api)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# GitHub Personal Access Token (Optional, but strongly recommended)
# Unauthenticated requests are limited by GitHub to 60 req/hr.
# Providing a PAT increases rate limits to 5,000 req/hr.
# Generate one at: https://github.com/settings/tokens (classic token with `repo` or `public_repo` scope)
GITHUB_TOKEN=

# In-memory Git Tree cache TTL in milliseconds (default: 60000 = 60s)
CACHE_TTL_MS=60000

# ------------------------------------------------------------------------------
# MCP Server Configuration (@knowiki/mcp)
# ------------------------------------------------------------------------------
MCP_PORT=3002
KNOWIKI_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# CLI Configuration (@knowiki/cli)
# ------------------------------------------------------------------------------
# Set to custom API URL if overriding the default
# KNOWIKI_API_URL=http://localhost:3000
